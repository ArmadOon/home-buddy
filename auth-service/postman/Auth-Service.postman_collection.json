							"raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/household/join",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"household",
								"join"
							]
						},
						"description": "Join an existing household using invite code"
					},
					"response": []
